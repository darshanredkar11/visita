# VisitorPass — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to source control.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Runtime connection string -- MUST be the least-privilege `visitorpass_app`
# role (migration 024), never the `visitorpass` owner role. Row-level
# security (migration 023) only has any effect through a non-superuser,
# non-BYPASSRLS role; `visitorpass` is a Postgres superuser (it's
# POSTGRES_USER, the cluster bootstrap role) and superusers bypass RLS
# unconditionally with no override.
DATABASE_URL=postgres://visitorpass_app:CHANGEME_APP_ROLE_PASSWORD@localhost:5432/visitorpass

# Migration-only connection string -- needs DDL rights (CREATE TABLE, CREATE
# POLICY, ...) that DATABASE_URL's role deliberately lacks. Used once at
# startup then dropped; the `visitorpass` owner role is fine here.
# Falls back to DATABASE_URL if unset (only correct for a single-role
# local/dev setup where RLS enforcement doesn't matter).
MIGRATION_DATABASE_URL=postgres://visitorpass:CHANGEME@localhost:5432/visitorpass

# `visitorpass_app`'s password is set by migration 024 to the placeholder
# above. In production, rotate BOTH together: `ALTER ROLE visitorpass_app
# PASSWORD '<new-secret>'` in Postgres, then update DATABASE_URL to match.

# Master key: 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
# Store in AWS Secrets Manager / HashiCorp Vault in production.
MASTER_KEY_HEX=<generate with: openssl rand -hex 32>

# Public base URL for share links
BASE_URL=https://your-domain.com

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Server bind (default: 0.0.0.0:8080)
HOST=0.0.0.0
PORT=8080

# Environment label (used in logging and error responses)
ENV=production

# Database connection pool
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# Logging (tracing filter syntax)
RUST_LOG=visitorpass=info,tower_http=info

# Let's Encrypt registration email (for Caddy)
ACME_EMAIL=admin@your-domain.com

# Notifications (V1: disabled by default)
SMS_ENABLED=false
EMAIL_ENABLED=true

# Default data retention (days) — plan-specific; set per-org after registration
DEFAULT_RETENTION_DAYS=90
