# VisitorPass — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to source control.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgres://visitorpass:CHANGEME@localhost:5432/visitorpass

# Master key: 64 hex characters (32 bytes).
# Generate with: openssl rand -hex 32
# Store in AWS Secrets Manager / HashiCorp Vault in production.
MASTER_KEY_HEX=<generate with: openssl rand -hex 32>

# Public base URL for share links
BASE_URL=https://your-domain.com

# ── OPTIONAL ──────────────────────────────────────────────────────────────────

# Server bind (default: 0.0.0.0:8080)
HOST=0.0.0.0
PORT=8080

# Environment label (used in logging and error responses)
ENV=production

# Database connection pool
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# Logging (tracing filter syntax)
RUST_LOG=visitorpass=info,tower_http=info

# Let's Encrypt registration email (for Caddy)
ACME_EMAIL=admin@your-domain.com

# Notifications (V1: disabled by default)
SMS_ENABLED=false
EMAIL_ENABLED=true

# Default data retention (days) — plan-specific; set per-org after registration
DEFAULT_RETENTION_DAYS=90
